# -----------------------------------------------------------------------------
# PatchPath Universal - Environment Configuration Example
# Copy this file to .env for local development.
# For Vercel production deployment, configure these in the Vercel Project Settings.
# DO NOT COMMIT REAL SECRETS OR PRODUCTION DATABASE PASSWORDS TO GIT.
# -----------------------------------------------------------------------------

# Secret key used for signing session JWT tokens.
# Required in production. Minimum 32-character random string.
# Example generator: openssl rand -hex 32
PATCHPATH_SECRET_KEY=replace-with-a-random-secret-before-network-use

# Database connection URL.
# In local development: defaults to SQLite (sqlite:///./patchpath.db).
# In production on Vercel: set to your Neon Postgres pooled connection URL, e.g.:
# postgresql://[user]:[password]@[neon-hostname]-pooler.neon.tech/neondb?sslmode=require
# Note: Also detects POSTGRES_URL automatically from Vercel Neon Integration.
PATCHPATH_DATABASE_URL=sqlite:///./patchpath.db

# Frontend origin allowed for CORS and CSRF verification.
# In local development: http://localhost:5173
# In production on Vercel: your preview/production URL, e.g.:
# https://patchpath-dt.vercel.app
PATCHPATH_FRONTEND_ORIGIN=http://localhost:5173

# Enforce secure cookies (transmitted only over HTTPS).
# Set to 'true' in production (HTTPS). Set to 'false' for local HTTP development.
PATCHPATH_COOKIE_SECURE=false

# Environment mode ('production' or 'development').
PATCHPATH_ENV=development

# Allow one-click demo login.
# Default is 'false' in production, 'true' in development.
PATCHPATH_ALLOW_DEMO_LOGIN=true
